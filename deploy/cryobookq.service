[Unit]
Description=CryoBookQ orderbook quality comparer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/apps/cryobookq
EnvironmentFile=-/apps/cryobookq/.env
ExecStart=/apps/cryobookq/.venv/bin/python -m cryobookq.daemon --venues deribit,coincall
Restart=on-failure
RestartSec=5
MemoryMax=2G
LimitNOFILE=65536
# Health JSON: curl 127.0.0.1:8091/health (BOOKQ_HEALTH_PORT)
ReadWritePaths=/apps/cryobookq/data /apps/cryobookq/logs

# Hub UI is a separate unit: deploy/cryobookq-hub.service (port 8088).

[Install]
WantedBy=multi-user.target
