# CryoBookQ local env — copy to .env (never commit .env)

# ── Capture ──────────────────────────────────────────────────────────────
BOOKQ_UNDERLYING=BTC
BOOKQ_DEPTH=5
BOOKQ_SNAPSHOT_INTERVAL_MIN=15
BOOKQ_DATA_DIR=./data

# ── Coincall (read-only; required if options WS needs signed URL — verify in M0)
COINCALL_API_KEY=
COINCALL_API_SECRET=
# COINCALL_ENV=production

# ── Optional alerts ──────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Hub ──────────────────────────────────────────────────────────────────
# BOOKQ_HUB_PORT=8088

# ── Deploy (local machine only; not needed for capture) ──────────────────
# SSH_KEY=/path/to/id_ed25519
