# CryoBookQ local env — copy to .env (never commit .env)

# ── Capture ──────────────────────────────────────────────────────────────
BOOKQ_UNDERLYING=BTC
BOOKQ_DEPTH=5
BOOKQ_SNAPSHOT_INTERVAL_MIN=15
BOOKQ_DATA_DIR=./data

# ── Coincall (read-only; options WS requires signed URL — confirmed in M0)
# Seed from CryoTrader COINCALL_API_KEY_PROD / COINCALL_API_SECRET_PROD
COINCALL_API_KEY=
COINCALL_API_SECRET=
# COINCALL_ENV=production

# ── Optional alerts ──────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Hub / health ─────────────────────────────────────────────────────────
# BOOKQ_HUB_PORT=8088
# BOOKQ_HEALTH_PORT=8091
# BOOKQ_HUB_SNAPSHOT_N=4
# BOOKQ_HUB_MOUNT=/bookq

# ── Quality / disk (P0) ──────────────────────────────────────────────────
# BOOKQ_COVERAGE_FLOOR_DERIBIT=0.90
# BOOKQ_COVERAGE_FLOOR_COINCALL=0.80
# BOOKQ_COVERAGE_FLOOR_BYBIT=0.80
# BOOKQ_COVERAGE_FLOOR_OKX=0.80
# BOOKQ_COVERAGE_FLOOR_BINANCE=0.80
# BOOKQ_BURST_TIMEOUT_S=40
# BOOKQ_WS_COLLECT_S=30
# Binance sampler (peers keep BOOKQ_BURST_TIMEOUT_S)
# BOOKQ_BINANCE_COLLECT_S=30
# BOOKQ_BINANCE_REST_BUDGET_S=45
# BOOKQ_BINANCE_TIMEOUT_S=90
# BOOKQ_DISK_FREE_WARN_MB=5000
# BOOKQ_DISK_FREE_ABORT_MB=500

# ── P1 clock / instrument cache ──────────────────────────────────────────
# BOOKQ_INSTRUMENT_CACHE_TTL_S=1800
# BOOKQ_CLOCK_RESYNC_EVERY_S=900

# ── Deploy (local machine only; not needed for capture) ──────────────────
# SSH_KEY=/path/to/id_ed25519

# ── Live tests ───────────────────────────────────────────────────────────
# BOOKQ_SKIP_LIVE=1
